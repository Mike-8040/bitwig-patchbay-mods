{
  "manifest_version": 2,
  "mod": {
    "id": "show-automation-lane",
    "name": "Automation: Show Automation Lane",
    "version": "0.1.0-dev.1",
    "author": "Mike8040",
    "description": "Reveals the existing automation lane from the device parameter menu.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "targets": {
    "awj.Gef": {
      "kind": "method",
      "owner": "awj",
      "name": "Gef",
      "descriptor": "(LdLW;)V"
    },
    "awj": {
      "kind": "class",
      "class": "awj"
    },
    "apr.beI": {
      "kind": "field",
      "owner": "apr",
      "name": "beI",
      "descriptor": "LgSD;"
    }
  },
  "hooks": [
    {
      "id": "show-before-delete",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "beforeDelete",
        "descriptor": "(Lawj;LdLW;)V",
        "args": [
          "this",
          "arg1"
        ]
      },
      "target": "awj.Gef"
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "org.mike8040.showautomationlane.ShowLane"
  },
  "opens": [
    "apr.beI",
    "awj"
  ]
}
