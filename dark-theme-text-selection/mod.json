{
  "manifest_version": 2,
  "mod": {
    "id": "dark-theme-text-selection",
    "name": "Interface: Dark Theme Text Selection",
    "author": "Mike8040",
    "version": "0.1.0-dev.1",
    "description": "Keeps native selected text readable in Bitwig text fields.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "targets": {
    "ejJ.unz": {
      "kind": "method",
      "owner": "ejJ",
      "name": "unz",
      "descriptor": "(Ljava/lang/String;Lekg;)V"
    },
    "egM.yAy": {
      "kind": "method",
      "owner": "egM",
      "name": "yAy",
      "descriptor": "()LegG;"
    }
  },
  "hooks": [
    {
      "id": "selected-glyph-ink",
      "transform": "REPLACE_INVOKE",
      "bridge": {
        "method": "selectedGlyphColor",
        "descriptor": "(LegM;)LegG;",
        "args": []
      },
      "target": "ejJ.unz",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "egM.yAy",
        "occurrence": 1
      }
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "org.mike8040.darkthemetextselection.TextSelection"
  }
}
