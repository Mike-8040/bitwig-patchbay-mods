{
  "manifest_version": 2,
  "mod": {
    "id": "plugin-space-for-transport",
    "name": "Transport: Plug-in Space for Transport",
    "version": "0.1.0-dev.1",
    "author": "Mike8040",
    "description": "Routes unmodified Space to Bitwig transport in supported non-editing plug-in windows.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "targets": {
    "com.bitwig.win32_windowing_system.Win32Display.init": {
      "kind": "method",
      "owner": "com/bitwig/win32_windowing_system/Win32Display",
      "name": "<init>",
      "descriptor": "(Lcom/bitwig/windowing_system/Mlq;Lcom/bitwig/windowing_system/WNY;)V"
    }
  },
  "hooks": [
    {
      "id": "start-after-native-display",
      "transform": "INSERT_BEFORE_FINAL_RETURN",
      "bridge": {
        "method": "startGuard",
        "descriptor": "()V",
        "args": []
      },
      "target": "com.bitwig.win32_windowing_system.Win32Display.init"
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "org.mike8040.pluginspace.PluginSpaceBootstrap"
  }
}
