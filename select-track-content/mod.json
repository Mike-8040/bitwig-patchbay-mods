{
  "manifest_version": 2,
  "mod": {
    "id": "select-track-content",
    "name": "Arranger: Select Track Content",
    "version": "0.1.0-dev.1",
    "author": "Mike8040",
    "description": "Selects a track's Arranger clips from its header context menu.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "targets": {
    "dwF.jTs": {
      "kind": "method",
      "owner": "dwF",
      "name": "jTs",
      "descriptor": "(DDLeqv;)LdMt;"
    }
  },
  "hooks": [
    {
      "id": "remember-clicked-track",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "capture",
        "descriptor": "(LdwF;DD)V",
        "args": [
          "this",
          "arg1",
          "arg3"
        ]
      },
      "target": "dwF.jTs"
    },
    {
      "id": "extend-native-track-menu",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "addRows",
        "descriptor": "(LdMt;)LdMt;",
        "args": []
      },
      "target": "dwF.jTs"
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "org.mike8040.trackselect.SelectMenu"
  }
}
