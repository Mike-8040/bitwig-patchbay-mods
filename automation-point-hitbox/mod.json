{
  "manifest_version": 2,
  "mod": {
    "id": "automation-point-hitbox",
    "name": "Automation: Point Focus Hitbox Correction",
    "version": "0.1.0-dev.1",
    "author": "Mike8040",
    "description": "Improves selecting automation points. Bug since Bitwig Beta Phase where new points get created even if focus of existing point is correct. This behavior is noticeable mostly on 4K monitors.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "targets": {
    "com.bitwig.flt.widget.core.timeline.interaction.Ymy.Gef": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/timeline/interaction/Ymy",
      "name": "Gef",
      "descriptor": "(LLCN;D)Lcom/bitwig/base/geom/DoubleRectangle;"
    },
    "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/timeline/interaction/Ymy",
      "name": "beI",
      "descriptor": "(LLCN;D)V"
    },
    "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI-2": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/timeline/interaction/Ymy",
      "name": "beI",
      "descriptor": "(LLCN;DLcom/bitwig/base/geom/DoubleRectangle;Lcom/bitwig/base/geom/DoublePoint;)Z"
    },
    "com.bitwig.flt.widget.core.timeline.interaction.Ymy.Gef-2": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/timeline/interaction/Ymy",
      "name": "Gef",
      "descriptor": "(LLCN;DLcom/bitwig/base/geom/DoubleRectangle;Lcom/bitwig/base/geom/DoublePoint;)Z"
    },
    "com.bitwig.flt.widget.core.timeline.interaction.Ymy.lv_": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/timeline/interaction/Ymy",
      "name": "lv_",
      "descriptor": "()V"
    }
  },
  "hooks": [
    {
      "id": "scaled-point-bounds",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "bounds",
        "descriptor": "(Lcom/bitwig/base/geom/DoubleRectangle;Lcom/bitwig/flt/widget/core/timeline/interaction/Ymy;)Lcom/bitwig/base/geom/DoubleRectangle;",
        "args": [
          "this"
        ]
      },
      "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.Gef"
    },
    {
      "id": "select-nearest-point-tight",
      "transform": "REPLACE_INVOKE",
      "bridge": {
        "method": "hitTight",
        "descriptor": "(Lcom/bitwig/flt/widget/core/timeline/interaction/Ymy;LLCN;DLcom/bitwig/base/geom/DoubleRectangle;Lcom/bitwig/base/geom/DoublePoint;)Z",
        "args": []
      },
      "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI-2",
        "occurrence": 2
      }
    },
    {
      "id": "select-nearest-point-wide",
      "transform": "REPLACE_INVOKE",
      "bridge": {
        "method": "hitWide",
        "descriptor": "(Lcom/bitwig/flt/widget/core/timeline/interaction/Ymy;LLCN;DLcom/bitwig/base/geom/DoubleRectangle;Lcom/bitwig/base/geom/DoublePoint;)Z",
        "args": []
      },
      "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.Gef-2",
        "occurrence": 1
      }
    },
    {
      "id": "skip-interpolation-candidate-when-missing",
      "transform": "REPLACE_INVOKE",
      "bridge": {
        "method": "hitPrevious",
        "descriptor": "(Lcom/bitwig/flt/widget/core/timeline/interaction/Ymy;LLCN;DLcom/bitwig/base/geom/DoubleRectangle;Lcom/bitwig/base/geom/DoublePoint;)Z",
        "args": []
      },
      "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.Gef-2",
        "occurrence": 1
      }
    },
    {
      "id": "continue-searching-nearby-points",
      "transform": "REPLACE_INVOKE",
      "bridge": {
        "method": "stop",
        "descriptor": "(Lcom/bitwig/flt/widget/core/timeline/interaction/Ymy;)V",
        "args": []
      },
      "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.beI",
      "match": {
        "opcode": "INVOKEVIRTUAL",
        "target": "com.bitwig.flt.widget.core.timeline.interaction.Ymy.lv_",
        "occurrence": 1
      }
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "org.mike8040.automationpointhitbox.PointHitbox"
  }
}
